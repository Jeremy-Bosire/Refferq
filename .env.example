# Copy to .env.local for local development. Never commit populated environment files.

# Runtime and database
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/ganjilink
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Product identity. Keep legal and contact claims unset until verified.
NEXT_PUBLIC_BRAND_NAME=GanjiLink
NEXT_PUBLIC_BRAND_PRIMARY_COLOR=#2563eb
BUSINESS_REG_NO=
SUPPORT_EMAIL=
SUPPORT_PHONE=
DOMAIN=

# Admin access
ADMIN_EMAILS=admin@example.com

# Resend email
RESEND_API_KEY=
RESEND_FROM_EMAIL=GanjiLink <onboarding@resend.dev>

# Optional SMS provider (not enabled until configured)
SMS_PROVIDER=none
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=

# Daraja. Sandbox credentials only during development; production activation is manual.
MPESA_ENABLED=false
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_STK_CALLBACK_URL=
MPESA_C2B_VALIDATION_URL=
MPESA_C2B_CONFIRMATION_URL=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_B2C_RESULT_URL=
MPESA_B2C_TIMEOUT_URL=

# Payment and payout providers remain disabled until their adapters and safeguarding
# arrangement are implemented and reviewed.
PAYMENT_COLLECTOR=disabled
PAYOUT_PROVIDER=disabled
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
